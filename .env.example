# Copy to apps/web/.env.local. The Prisma CLI reads packages/db/.env
# (copy packages/db/.env.example there; it only needs DATABASE_URL).
# Mock mode (dev only, toggle in the bottom-left corner) needs none of the keys.

# ---------------------------------------------------------------------------
# Required for real interviews
# ---------------------------------------------------------------------------

# Claude: every prompt plus company research (web search must be enabled for
# your Anthropic organization; it is billed per search).
ANTHROPIC_API_KEY=
# OpenAI: Whisper transcription of your answers.
OPENAI_API_KEY=
# ElevenLabs: the interviewer's voice.
ELEVENLABS_API_KEY=

# Postgres. Matches docker-compose.yml (host port 5436, loopback only).
DATABASE_URL=postgresql://interviewiq:interviewiq@localhost:5436/interviewiq

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------

# Interviewer model (all prompts except the coach). Default: claude-sonnet-5
CLAUDE_MODEL=
# Model for the mid-interview coach ("explain this"). Default: claude-haiku-4-5
COACH_MODEL=

# ElevenLabs voice ids per interview language (defaults are premade voices).
ELEVENLABS_VOICE_EN=
ELEVENLABS_VOICE_PT_BR=
ELEVENLABS_VOICE_ES=

# Postgres password used by docker-compose.yml (default: interviewiq). If you
# change it, change it in DATABASE_URL here and in packages/db/.env too.
# docker compose reads it from your shell or a root .env file, not this one.
POSTGRES_PASSWORD=

# Optional: video interviewer (needs D-ID credits). Leave empty for audio only.
DID_API_KEY=
# Portrait image for the avatar. Default: a public D-ID sample presenter.
DID_PRESENTER_URL=
