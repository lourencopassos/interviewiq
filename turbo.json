{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["**/.env.*local"],
  "globalEnv": [
    "ANTHROPIC_API_KEY",
    "OPENAI_API_KEY",
    "ELEVENLABS_API_KEY",
    "DATABASE_URL",
    "CLAUDE_MODEL",
    "COACH_MODEL",
    "DID_API_KEY",
    "DID_PRESENTER_URL",
    "ELEVENLABS_VOICE_EN",
    "ELEVENLABS_VOICE_PT_BR",
    "ELEVENLABS_VOICE_ES",
    "POSTGRES_PASSWORD"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {},
    "typecheck": {
      "outputs": []
    },
    "test": {
      "cache": false,
      "outputs": []
    },
    "db:push": {
      "cache": false
    },
    "db:generate": {
      "cache": false
    }
  }
}
