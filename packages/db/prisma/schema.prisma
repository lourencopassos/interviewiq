generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Session {
  id             String        @id @default(cuid())
  createdAt      DateTime      @default(now())
  clientId       String
  jobTitle       String
  companyName    String
  jobDescription String        @db.Text
  difficulty     Difficulty     @default(MID)
  interviewType  InterviewType  @default(TECHNICAL)
  language       Language       @default(EN)
  status         SessionStatus  @default(SETUP)
  currentIndex   Int            @default(0)
  parsedJob      String?        @db.Text
  companyIntel   String?        @db.Text
  resumeText     String?        @db.Text
  opening        String?        @db.Text
  closing        String?        @db.Text
  videoMode      Boolean        @default(false)
  coachEnabled   Boolean        @default(true)
  questions      Question[]
  report         Report?
  coachNotes     CoachNote[]

  @@index([clientId])
}

model Question {
  id         String  @id @default(cuid())
  sessionId  String
  session    Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  order      Int
  text       String  @db.Text
  category   String
  stage      InterviewStage?
  metadata   String? @db.Text
  transcript String? @db.Text
  score      Int?
  feedback   String? @db.Text
  strengths  String? @db.Text
  gaps       String? @db.Text
  coachNotes CoachNote[]

  @@index([sessionId])
}

/// A mid-interview "explain this" exchange with the coach model.
model CoachNote {
  id                String    @id @default(cuid())
  createdAt         DateTime  @default(now())
  sessionId         String
  session           Session   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  questionId        String?
  question          Question? @relation(fields: [questionId], references: [id], onDelete: Cascade)
  source            CoachSource
  selection         String?   @db.Text
  prompt            String    @db.Text
  answer            String    @db.Text
  /// True when the candidate asked before answering the question (shown as "coached" in the report)
  askedBeforeAnswer Boolean   @default(false)
  model             String

  @@index([sessionId])
  @@index([questionId])
}

model Report {
  id                 String  @id @default(cuid())
  sessionId          String  @unique
  session            Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  overallScore       Int
  technicalScore     Int
  behavioralScore    Int
  communicationScore Int
  strengths          String  @db.Text
  weaknesses         String  @db.Text
  studyPlan          String  @db.Text
  summary            String  @db.Text
}

enum Difficulty {
  JUNIOR
  MID
  SENIOR
  STAFF
}

enum InterviewType {
  PHONE_SCREEN
  TECHNICAL
  BEHAVIORAL
  SYSTEM_DESIGN
  FULL_LOOP
}

enum Language {
  EN
  PT_BR
  ES
}

/// A Full Loop stage; null for single-type interviews.
enum InterviewStage {
  PHONE_SCREEN
  TECHNICAL
  BEHAVIORAL
  SYSTEM_DESIGN
}

/// What the candidate selected when asking the coach.
enum CoachSource {
  question
  transcript
  free
}

model CompanyResearch {
  id          String   @id @default(cuid())
  companyName String   @unique
  data        String   @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

enum SessionStatus {
  SETUP
  BRIEFING
  INTERVIEWING
  WRAPPING_UP
  COMPLETED
  ABANDONED
}
